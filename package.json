{
  "name": "mcp-proxy-conductor",
  "version": "0.3.0",
  "description": "Local MCP proxy that aggregates dynamically managed downstream MCP servers, managed at runtime without restarting the client.",
  "type": "module",
  "license": "MIT",
  "author": "Patrick Cornelißen (https://github.com/pcornelissen)",
  "homepage": "https://github.com/pc-software-org/ai-conductor#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pc-software-org/ai-conductor.git"
  },
  "bugs": {
    "url": "https://github.com/pc-software-org/ai-conductor/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "proxy",
    "aggregator",
    "claude",
    "llm",
    "ai"
  ],
  "bin": {
    "mcp-proxy-conductor": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "gen:version": "node scripts/gen-version.mjs",
    "build": "pnpm gen:version && tsup",
    "dev": "pnpm gen:version && tsx src/index.ts",
    "test": "pnpm gen:version && vitest run",
    "test:watch": "pnpm gen:version && vitest",
    "typecheck": "pnpm gen:version && tsc --noEmit",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@napi-rs/keyring": "^2.0.0",
    "env-paths": "^4.0.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "tsup": "^8.3.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "pnpm": {
    "overrides": {
      "fast-uri": "^4.1.4",
      "ip-address": "^10.7.0",
      "hono": "^4.13.7",
      "@hono/node-server": "^2.1.1",
      "qs": "^6.16.0",
      "body-parser": "^2.3.0",
      "esbuild": "^0.28.1"
    }
  }
}
